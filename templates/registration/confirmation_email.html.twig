<h1>{{ 'email.confirm.heading'|trans }}</h1>

<p>
    {{ 'email.confirm.instructions'|trans }}<br><br>
    <a href="{{ signedUrl|raw }}">{{ 'email.confirm.action'|trans }}</a>.
    {{ 'email.confirm.expiry'|trans({
        '%expiration%': expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle')
    }) }}
</p>

<p>
    {{ 'email.signature'|trans }}
</p>