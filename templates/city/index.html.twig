{% extends 'base.html.twig' %}

{% block title %}{{ 'city.choose'|trans }}{% endblock %}

{% block body %}
    {% set locationAllowed = app.user.profile and app.user.profile.locationAccess %}
    <div class="min-h-screen bg-stone-200 font-sans text-slate-950">
        <div
            class="relative mx-auto min-h-screen w-full max-w-md bg-[#f8f8ff] pb-28 shadow-xl lg:max-w-7xl lg:pb-12 lg:pt-20 lg:shadow-none"
            data-controller="city-location"
            data-city-location-allowed-value="{{ locationAllowed ? 'true' : 'false' }}"
            data-city-location-disabled-message-value="{{ 'location.disabled'|trans }}"
            data-city-location-enable-message-value="{{ 'location.enable_for_city'|trans }}"
            data-city-location-unavailable-message-value="{{ 'location.unavailable'|trans }}"
            data-city-location-searching-message-value="{{ 'location.searching'|trans }}"
            data-city-location-error-message-value="{{ 'location.city_error'|trans }}"
            data-city-location-no-city-message-value="{{ 'location.no_city_coordinates'|trans }}"
            data-city-location-detected-message-value="{{ 'location.city_detected'|trans }}"
        >
            <header class="flex min-h-24 items-center gap-3 border-b border-slate-100 bg-white px-5 py-5">
                <a href="{{ path('app_home') }}" class="flex size-10 shrink-0 items-center justify-center" aria-label="{{ 'common.back_home'|trans }}">{{ include('components/_icon.html.twig', {name: 'back', class: 'size-8'}) }}</a>
                <div>
                    <h1 class="text-2xl font-bold">{{ 'city.choose'|trans }}</h1>
                    <p class="text-sm text-stone-400">{{ 'city.toulouse_area'|trans }}</p>
                </div>
            </header>

            <main class="px-5 py-10 lg:px-8">
                {% for flash in app.flashes('success') %}
                    <div class="mb-5 rounded-xl border-l-4 border-lime-500 bg-white px-4 py-3 text-sm shadow-sm" role="status">
                        {{ flash }}
                    </div>
                {% endfor %}

                <form method="get" action="{{ path('app_city_select') }}" class="flex h-16 items-center gap-3 rounded-[1.15rem] border border-red-100 bg-transparent px-4 focus-within:border-red-400 focus-within:ring-2 focus-within:ring-red-100">
                    {{ include('components/_icon.html.twig', {name: 'search', class: 'size-6 shrink-0 text-stone-400'}) }}
                    <input type="search" name="query" value="{{ search }}" class="min-w-0 flex-1 border-0 bg-transparent text-base outline-none placeholder:text-stone-400" placeholder="{{ 'city.search_placeholder'|trans }}" aria-label="{{ 'city.search'|trans }}">
                    <button type="submit" class="text-sm font-semibold text-red-600">{{ 'common.search'|trans }}</button>
                </form>

                <section class="mt-4 rounded-2xl bg-slate-900 px-5 py-7 text-white" aria-labelledby="current-city-title">
                    <div class="flex items-center gap-4">
                        <span class="flex size-14 items-center justify-center rounded-xl bg-white/15" aria-hidden="true">{{ include('components/_icon.html.twig', {name: 'building', class: 'size-7'}) }}</span>
                        <div class="min-w-0 flex-1">
                            <p id="current-city-title" class="text-xs font-semibold uppercase text-slate-300">{{ 'city.current'|trans }}</p>
                            <p class="mt-1 truncate text-2xl font-bold">{{ app.user.city ? app.user.city.name : 'city.none'|trans }}</p>
                        </div>
                        {% if app.user.city %}
                            <span class="flex size-9 items-center justify-center rounded-full bg-red-600" aria-label="{{ 'city.selected'|trans }}">{{ include('components/_icon.html.twig', {name: 'check', class: 'size-5'}) }}</span>
                        {% endif %}
                    </div>
                </section>

                <button
                    type="button"
                    class="mt-7 flex w-full items-center gap-4 rounded-xl px-5 py-4 text-left transition {{ locationAllowed ? 'hover:bg-white' : 'cursor-not-allowed opacity-50' }}"
                    data-city-location-target="button"
                    data-action="city-location#locate"
                    {% if not locationAllowed %}disabled aria-disabled="true"{% endif %}
                >
                    {{ include('components/_icon.html.twig', {name: 'pin', class: 'size-7 shrink-0'}) }}
                    <span>
                        <span class="block font-semibold">{{ 'city.use_gps'|trans }}</span>
                        <span class="block text-xs text-slate-500">{{ 'city.gps_help'|trans }}</span>
                    </span>
                </button>
                <p class="px-5 text-xs text-slate-500" data-city-location-target="status" aria-live="polite">
                    {{ locationAllowed ? '' : 'location.disabled'|trans }}
                </p>
                {% if not locationAllowed %}
                    <a href="{{ path('app_profile') }}" class="ml-5 mt-1 inline-flex text-xs font-semibold text-red-600 underline underline-offset-2">{{ 'profile.update_preferences'|trans }}</a>
                {% endif %}

                <section class="mt-10" aria-labelledby="all-cities-title">
                    <div class="mb-5 flex items-center justify-between">
                        <h2 id="all-cities-title" class="text-xl font-semibold">{{ 'city.all'|trans }}</h2>
                        <span class="rounded bg-red-50 px-3 py-1 text-xs font-semibold text-red-600">{{ 'city.count'|trans({'%count%': cities|length}) }}</span>
                    </div>

                    {% if cities is empty %}
                        <div class="rounded-xl bg-white px-5 py-8 text-center text-sm text-stone-500 shadow-sm">
                            {{ 'city.no_result'|trans }}
                        </div>
                    {% else %}
                        <div class="space-y-4 lg:grid lg:grid-cols-2 lg:gap-4 lg:space-y-0">
                            {% for city in cities %}
                                {% set selected = app.user.city and app.user.city.id == city.id %}
                                <form
                                    action="{{ path('app_city_choose', {id: city.id}) }}"
                                    method="post"
                                    class="rounded-xl"
                                    data-city-location-target="city"
                                    data-city-name="{{ city.name }}"
                                    data-latitude="{{ city.latitude }}"
                                    data-longitude="{{ city.longitude }}"
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token('choose_city') }}">
                                    <button type="submit" class="flex min-h-24 w-full items-center gap-4 rounded-2xl border bg-white px-5 py-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:shadow-md {{ selected ? 'border-red-600' : 'border-slate-100' }}">
                                        <span class="flex size-12 shrink-0 items-center justify-center rounded-xl {{ selected ? 'bg-slate-950 text-white' : 'bg-slate-100 text-slate-400' }}" aria-hidden="true">{{ include('components/_icon.html.twig', {name: 'building', class: 'size-6'}) }}</span>
                                        <span class="min-w-0 flex-1">
                                            <span class="block truncate text-base font-bold">{{ city.name }}</span>
                                            <span class="block text-xs text-slate-500">{{ 'city.postal_code'|trans({'%code%': city.postalCode}) }}</span>
                                        </span>
                                        {% if selected %}
                                            <span class="flex size-7 items-center justify-center rounded-full bg-red-600 text-white" aria-label="{{ 'city.selected'|trans }}">{{ include('components/_icon.html.twig', {name: 'check', class: 'size-4'}) }}</span>
                                        {% else %}
                                            {{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-6 text-stone-400'}) }}
                                        {% endif %}
                                    </button>
                                </form>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            </main>

            {{ include('components/_bottom_nav.html.twig', { active: 'home' }) }}
        </div>
    </div>
{% endblock %}