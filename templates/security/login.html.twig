{# Formulaire de connexion à SafeCity. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login_title'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-stone-200 font-sans text-slate-950">
        <main class="mx-auto min-h-screen w-full max-w-md bg-[#f8f8ff] px-6 pb-14 pt-8 shadow-xl lg:my-10 lg:min-h-0 lg:max-w-xl lg:rounded-3xl lg:px-10 lg:py-10">
            {{ include('components/_brand.html.twig') }}

            <div class="mx-auto mt-10 grid max-w-sm grid-cols-2 overflow-hidden rounded-xl bg-stone-100 text-lg font-semibold">
                <span class="flex h-14 items-center justify-center bg-red-600 text-white">{{ 'auth.login'|trans }}</span>
                <a href="{{ path('app_register') }}" class="flex h-14 items-center justify-center text-slate-950">{{ 'auth.registration'|trans }}</a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="mt-6 rounded-xl border-l-4 border-lime-500 bg-white px-4 py-3 text-sm shadow-sm" role="status">
                    {{ message }}
                </div>
            {% endfor %}

            {% if error %}
                <div class="mt-6 rounded-xl border-l-4 border-red-600 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
                    {# Seuls les messages explicitement prévus pour l'utilisateur
                       sont affichés ; les autres erreurs restent génériques. #}
                    {% set safeErrorKeys = ['auth.account_disabled', 'auth.email_not_verified'] %}
                    {{ (error.messageKey in safeErrorKeys ? error.messageKey : 'auth.invalid_credentials')|trans(error.messageData) }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mt-6 rounded-xl bg-white px-4 py-3 text-sm shadow-sm">
                    {{ 'auth.logged_in_as'|trans({'%email%': app.user.userIdentifier}) }}
                    <a href="{{ path('app_home') }}" class="font-semibold text-red-600">{{ 'common.continue'|trans }}</a>
                </div>
            {% endif %}

            <form method="post" class="mt-9 space-y-6">
                <div>
                    <label for="username" class="mb-2 block text-base font-semibold">{{ 'form.email'|trans }}</label>
                    <div class="flex h-16 items-center gap-4 rounded-[1.15rem] border border-red-200 bg-transparent px-5 focus-within:border-red-500 focus-within:ring-2 focus-within:ring-red-100">
                        {{ include('components/_icon.html.twig', {name: 'mail', class: 'size-6 shrink-0 text-stone-500'}) }}
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            class="min-w-0 flex-1 border-0 bg-transparent text-base outline-none placeholder:text-stone-400"
                            autocomplete="email"
                            placeholder="exemple@email.com"
                            required
                            autofocus
                        >
                    </div>
                </div>

                <div>
                    <div class="mb-2 flex items-center justify-between gap-4">
                        <label for="password" class="text-base font-semibold">{{ 'form.password'|trans }}</label>
                        <a href="{{ path('app_forgot_password_request') }}" class="text-sm font-medium text-red-600 underline">
                            {{ 'auth.forgot_password'|trans }}
                        </a>
                    </div>
                    <div class="flex h-16 items-center gap-4 rounded-[1.15rem] border border-red-200 bg-transparent px-5 focus-within:border-red-500 focus-within:ring-2 focus-within:ring-red-100" data-controller="password-visibility">
                        {{ include('components/_icon.html.twig', {name: 'lock', class: 'size-6 shrink-0 text-stone-500'}) }}
                        <input
                            type="password"
                            name="_password"
                            id="password"
                            class="min-w-0 flex-1 border-0 bg-transparent text-base outline-none placeholder:text-stone-400"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            data-password-visibility-target="input"
                            required
                        >
                        <button
                            type="button"
                            class="flex size-10 items-center justify-center text-xl text-stone-500"
                            data-action="password-visibility#toggle"
                            aria-label="{{ 'auth.toggle_password'|trans }}"
                            aria-pressed="false"
                        >
                            <span data-password-visibility-target="icon" aria-hidden="true">{{ include('components/_icon.html.twig', {name: 'eye', class: 'size-6'}) }}</span>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="flex h-[4.5rem] w-full items-center justify-center gap-4 rounded-[1.15rem] bg-red-600 text-xl font-semibold text-white shadow-sm transition hover:bg-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
                    {{ 'auth.sign_in'|trans }}
                    {{ include('components/_icon.html.twig', {name: 'logout', class: 'size-7 rotate-180'}) }}
                </button>
            </form>

            {# Le renvoi reste disponible sans connexion et protège l'adresse avec un message générique. #}
            <details class="mt-6 rounded-2xl border border-red-100 bg-white p-5 shadow-sm">
                <summary class="cursor-pointer font-semibold text-red-700">{{ 'auth.resend_confirmation'|trans }}</summary>
                <p class="mt-3 text-sm leading-6 text-stone-500">{{ 'auth.resend_confirmation_help'|trans }}</p>
                <form method="post" action="{{ path('app_resend_verification_email') }}" class="mt-4 space-y-3">
                    <label for="resend-verification-email" class="block text-sm font-semibold">{{ 'form.email'|trans }}</label>
                    <input
                        type="email"
                        id="resend-verification-email"
                        name="email"
                        value="{{ last_username }}"
                        autocomplete="email"
                        class="h-12 w-full rounded-xl border border-red-200 bg-white px-4 outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100"
                        required
                    >
                    <input type="hidden" name="_token" value="{{ csrf_token('resend_verification_email') }}">
                    <button type="submit" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-slate-950 px-4 text-sm font-bold text-white transition hover:bg-slate-800">
                        {{ include('components/_icon.html.twig', {name: 'mail', class: 'size-4'}) }}
                        {{ 'auth.resend_confirmation'|trans }}
                    </button>
                </form>
            </details>

            <p class="mx-auto mt-9 max-w-sm bg-stone-200 px-5 py-4 text-center text-xs leading-relaxed text-stone-500">
                {{ 'auth.login_terms'|trans }}
                <span class="mt-2 flex justify-center gap-3 font-semibold text-red-700">
                    <a href="{{ path('app_legal_terms') }}" class="underline underline-offset-2">{{ 'legal.terms_title'|trans }}</a>
                    <a href="{{ path('app_legal_privacy') }}" class="underline underline-offset-2">{{ 'legal.privacy_title'|trans }}</a>
                </span>
            </p>
        </main>
    </div>
{% endblock %}
