{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-[#f8f8ff] pb-10 text-slate-950 shadow-xl lg:my-10 lg:min-h-0 lg:max-w-4xl lg:rounded-3xl">
    <header class="flex h-24 items-center border-b border-slate-100 bg-white px-5">
        <a href="{{ is_granted('ROLE_ADMIN') ? path('app_admin') : path('app_home') }}" class="flex size-10 items-center justify-center" aria-label="{{ 'common.back'|trans }}">{{ include('components/_icon.html.twig', {name: 'back', class: 'size-8'}) }}</a>
        <h1 class="flex-1 text-center text-3xl font-semibold">{{ 'profile.title'|trans }}</h1>
        <span class="size-10"></span>
    </header>

    <div class="space-y-8 px-5 pt-10 lg:px-8 lg:pb-10">
        {% for message in app.flashes('success') %}
            <div class="rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">{{ message }}</div>
        {% endfor %}

        <section class="text-center" aria-label="Identité">
            <div class="relative mx-auto flex size-32 items-end justify-center overflow-hidden rounded-full border-[7px] border-slate-950 bg-white">
                <span class="absolute top-7 size-12 rounded-full bg-slate-950"></span>
                <span class="-mb-6 h-20 w-24 rounded-t-full bg-slate-950"></span>
                <span class="absolute bottom-0 right-0 flex size-10 items-center justify-center rounded-full border-4 border-white bg-red-600 text-white">{{ include('components/_icon.html.twig', {name: 'edit', class: 'size-5'}) }}</span>
            </div>
            <h2 class="mt-5 text-3xl font-medium">{{ user.firstName }} {{ user.lastName }}</h2>
            <p class="mt-1 text-lg">{{ user.city ? user.city.name : 'profile.city_missing'|trans }}</p>
            {% if is_granted('ROLE_ADMIN') %}<span class="mt-3 inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-bold text-red-700">{{ 'profile.administrator'|trans }}</span>{% endif %}
        </section>

        {# Les informations restent repliables, mais sont ouvertes par défaut
           afin de retrouver la hiérarchie visuelle de la maquette. #}
        <details class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm" open>
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-5">
                <span>
                    <strong class="block text-2xl">{{ 'profile.personal_information'|trans }}</strong>
                    <small class="mt-1 block text-slate-500">{{ user.email }}</small>
                </span>
                <span class="transition group-open:rotate-90">{{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-6'}) }}</span>
            </summary>
            {{ form_start(userForm, {attr: {class: 'space-y-4 border-t border-slate-100 px-5 pb-5 pt-4'}}) }}
                {% for field in [userForm.firstName, userForm.lastName, userForm.email] %}
                    <div>
                        {{ form_label(field, null, {label_attr: {class: 'mb-2 block text-sm font-semibold text-slate-600'}}) }}
                        {{ form_widget(field, {attr: {class: 'h-14 w-full rounded-2xl border border-slate-300 bg-white px-4 text-base outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100'}}) }}
                        <div class="mt-1 text-xs text-red-600">{{ form_errors(field) }}</div>
                    </div>
                {% endfor %}
                <div>
                    {{ form_label(userForm.city, null, {label_attr: {class: 'mb-2 block text-sm font-semibold text-slate-600'}}) }}
                    {{ form_widget(userForm.city, {attr: {class: 'h-14 w-full rounded-2xl border border-slate-300 bg-white px-4 text-base outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100'}}) }}
                    <div class="mt-1 text-xs text-red-600">{{ form_errors(userForm.city) }}</div>
                </div>
                <button type="submit" class="h-14 w-full rounded-2xl border border-slate-300 bg-white font-semibold text-stone-600 transition hover:border-red-300 hover:text-red-700">{{ 'profile.update_information'|trans }}</button>
            {{ form_end(userForm) }}
        </details>

        <details class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm" {% if not profileForm.vars.valid %}open{% endif %}>
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-5">
                <span class="flex items-center gap-3">
                    <span class="text-red-700">{{ include('components/_icon.html.twig', {name: 'settings', class: 'size-7'}) }}</span>
                    <span>
                    <strong class="block text-2xl">{{ 'profile.preferences'|trans }}</strong>
                    <small class="mt-1 block text-slate-500">{{ 'profile.preferences_summary'|trans }}</small>
                    </span>
                </span>
                <span class="transition group-open:rotate-90">{{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-6'}) }}</span>
            </summary>
            {{ form_start(profileForm, {attr: {class: 'border-t border-slate-100 px-5 pb-5 pt-4'}}) }}
                <h3 class="mb-3 flex items-center gap-2 font-bold text-red-700">{{ include('components/_icon.html.twig', {name: 'bell', class: 'size-5'}) }} {{ 'profile.notifications_and_alerts'|trans }}</h3>
                <div class="divide-y divide-slate-100">
                    {% for field in [
                        profileForm.emergencyNotifications,
                        profileForm.transportNotifications,
                        profileForm.eventNotifications
                    ] %}
                        <div class="flex items-center justify-between gap-4 py-3">
                            {{ form_label(field, null, {label_attr: {class: 'text-sm font-medium'}}) }}
                            <div>
                                {{ form_widget(field, {attr: {class: 'peer sr-only'}}) }}
                                <label for="{{ field.vars.id }}" class="relative block h-7 w-12 cursor-pointer rounded-full bg-slate-200 transition after:absolute after:left-1 after:top-1 after:size-5 after:rounded-full after:bg-white after:shadow after:transition peer-checked:bg-red-600 peer-checked:after:translate-x-5"></label>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <h3 class="mb-3 mt-5 flex items-center gap-2 font-bold text-red-700">{{ include('components/_icon.html.twig', {name: 'privacy', class: 'size-5'}) }} {{ 'profile.permissions'|trans }}</h3>
                <div class="divide-y divide-slate-100">
                    {% for field in [profileForm.cameraAccess, profileForm.locationAccess] %}
                        <div class="flex items-center justify-between gap-4 py-3">
                            {{ form_label(field, null, {label_attr: {class: 'text-sm font-medium'}}) }}
                            <div>
                                {{ form_widget(field, {attr: {class: 'peer sr-only'}}) }}
                                <label for="{{ field.vars.id }}" class="relative block h-7 w-12 cursor-pointer rounded-full bg-slate-200 transition after:absolute after:left-1 after:top-1 after:size-5 after:rounded-full after:bg-white after:shadow after:transition peer-checked:bg-red-600 peer-checked:after:translate-x-5"></label>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <p class="mt-3 rounded-xl bg-slate-50 px-3 py-3 text-xs leading-5 text-slate-600">
                    {{ 'profile.permissions_help'|trans }}
                </p>

                <div class="mt-5">
                    <div class="mb-2 flex items-center gap-2 font-bold text-red-700">
                        {{ include('components/_icon.html.twig', {name: 'globe', class: 'size-5'}) }}
                        {{ form_label(profileForm.language, null, {label_attr: {class: 'block'}}) }}
                    </div>
                    {{ form_widget(profileForm.language, {attr: {class: 'h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100'}}) }}
                </div>
                <button type="submit" class="mt-5 h-12 w-full rounded-2xl bg-slate-950 font-bold text-white">{{ 'profile.save_preferences'|trans }}</button>
            {{ form_end(profileForm) }}
        </details>

        <nav class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-[0_8px_24px_rgba(220,38,38,0.08)]" aria-label="{{ 'profile.links'|trans }}">
            <a href="{{ path('app_report_my_reports') }}" class="flex items-center gap-4 border-b border-slate-100 px-5 py-5">
                <span class="flex size-10 items-center justify-center text-red-700">{{ include('components/_icon.html.twig', {name: 'history', class: 'size-7'}) }}</span>
                <span class="flex-1 font-semibold">{{ 'profile.report_history'|trans }}</span>
                {{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-6'}) }}
            </a>
            <a href="{{ path('app_event_favorites') }}" class="flex items-center gap-4 border-b border-slate-100 px-5 py-5">
                <span class="flex size-10 items-center justify-center text-red-700">{{ include('components/_icon.html.twig', {name: 'heart', class: 'size-7'}) }}</span>
                <span class="flex-1 font-semibold">{{ 'profile.favorite_events'|trans }}</span>
                {{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-6'}) }}
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin') }}" class="flex items-center gap-4 px-5 py-5">
                    <span class="flex size-10 items-center justify-center text-red-700">{{ include('components/_icon.html.twig', {name: 'settings', class: 'size-7'}) }}</span>
                    <span class="flex-1 font-semibold">{{ 'profile.admin_area'|trans }}</span>
                    {{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-6'}) }}
                </a>
            {% endif %}
        </nav>

        <a href="{{ path('app_logout') }}" class="flex h-16 items-center justify-center gap-3 rounded-2xl border border-red-200 bg-red-50 font-bold text-red-700">{{ include('components/_icon.html.twig', {name: 'logout', class: 'size-6'}) }} {{ 'auth.logout'|trans }}</a>
        <a href="{{ path('app_profile_delete_confirm') }}" class="block text-center text-xs font-semibold text-slate-400 underline underline-offset-4">{{ 'profile.disable_account'|trans }}</a>
    </div>
</main>
{% endblock %}