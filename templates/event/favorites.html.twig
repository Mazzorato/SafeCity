{# Événements enregistrés dans les favoris de l’utilisateur. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'event.my_favorites'|trans }}{% endblock %}

{% block body %}
    {% set category_labels = {
        musique: 'event.category.music'|trans,
        sport: 'event.category.sport'|trans,
        culture: 'event.category.culture'|trans
    } %}
    {% set category_icons = {musique: 'music', sport: 'sport', culture: 'library'} %}

    <div class="min-h-screen bg-stone-200 font-sans text-slate-950">
        <div class="relative mx-auto min-h-screen w-full max-w-md bg-white pb-28 shadow-xl lg:max-w-7xl lg:pb-12 lg:pt-20 lg:shadow-none">
            <header class="flex h-24 items-center gap-3 px-5">
                <a href="{{ path('app_event') }}" class="flex size-8 items-center justify-center" aria-label="{{ 'event.back'|trans }}">{{ include('components/_icon.html.twig', {name: 'back', class: 'size-6'}) }}</a>
                <h1 class="text-2xl font-bold">{{ 'event.my_favorites_short'|trans }}</h1>
            </header>

            <main class="space-y-8 px-5 lg:px-8 lg:py-8">
                {% for message in app.flashes('success') %}
                    <div class="rounded-xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">{{ message }}</div>
                {% endfor %}

                {% if app.user.profile and not app.user.profile.eventNotifications %}
                    <div class="rounded-xl bg-orange-50 px-4 py-3 text-sm text-orange-900 ring-1 ring-orange-100">
                        <strong class="block">{{ 'event.reminders_disabled'|trans }}</strong>
                        <span>{{ 'event.reminders_disabled_help'|trans }}</span>
                    </div>
                {% endif %}

                <section class="flex items-center gap-5 rounded-xl bg-slate-800 px-4 py-4 text-white" aria-label="{{ 'event.favorites_summary'|trans }}">
                    <span class="flex size-12 items-center justify-center bg-red-600" aria-hidden="true">{{ include('components/_icon.html.twig', {name: 'bookmark', class: 'size-5'}) }}</span>
                    <div>
                        <p class="font-semibold">{{ 'event.saved_count'|trans({'%count%': favorites|length}) }}</p>
                        <p class="text-[10px] text-slate-300">{{ 'event.saved_help'|trans }}</p>
                    </div>
                </section>

                <section aria-labelledby="favorite-categories-title">
                    <h2 id="favorite-categories-title" class="mb-3 text-xl font-bold">{{ 'event.explore_category'|trans }}</h2>
                    <div class="grid grid-cols-3 gap-2 lg:grid-cols-6">
                        {% for value, label in category_labels %}
                            <a href="{{ path('app_event', {category: value}) }}" class="flex min-h-20 flex-col items-center justify-center rounded-xl bg-slate-100 text-center shadow-sm">
                                {{ include('components/_icon.html.twig', {name: category_icons[value], class: 'size-5'}) }}
                                <span class="mt-1 text-xs font-semibold">{{ label }}</span>
                                <span class="text-[10px] text-stone-400">{{ favorites|filter(favorite => favorite.event.category.value == value)|length }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </section>

                <section aria-labelledby="saved-events-title">
                    <div class="mb-4 flex items-center justify-between">
                        <h2 id="saved-events-title" class="text-xl font-bold">{{ 'event.saved_events'|trans }}</h2>
                        {% if favorites is not empty %}
                            <form method="post" action="{{ path('app_event_favorites_clear') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('clear_event_favorites') }}">
                                <button type="submit" class="text-xs font-medium text-red-600 underline">{{ 'common.remove_all'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>

                    <div class="space-y-8 lg:grid lg:grid-cols-2 lg:gap-6 lg:space-y-0">
                        {% for favorite in favorites %}
                            {% set event = favorite.event %}
                            <article>
                                <div class="flex h-36 items-center justify-center overflow-hidden rounded-xl bg-slate-200">
                                    {% if event.imageUrl %}
                                        <img src="{{ event.imageUrl }}" alt="" class="size-full object-cover">
                                    {% else %}
                                        {{ include('components/_icon.html.twig', {name: 'news', class: 'size-6'}) }}
                                    {% endif %}
                                </div>
                                <div class="mt-3 flex items-start justify-between gap-4 px-2">
                                    <div class="min-w-0 flex-1">
                                        <h3 class="truncate font-bold">{{ event.title }}</h3>
                                        <p class="mt-4 flex items-center gap-1 text-xs">{{ include('components/_icon.html.twig', {name: 'calendar', class: 'size-4'}) }} {{ event.startedAt|date('d/m/Y') }}{% if event.endedAt %} – {{ event.endedAt|date('d/m/Y') }}{% endif %}</p>
                                        <p class="flex items-center gap-1 text-xs">{{ include('components/_icon.html.twig', {name: 'pin', class: 'size-3 text-red-600'}) }} {{ event.location }}</p>
                                    </div>
                                    <form method="post" action="{{ path('app_event_favorite', {id: event.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('favorite' ~ event.id) }}">
                                        <input type="hidden" name="_target" value="favorites">
                                        <button type="submit" class="flex size-9 items-center justify-center bg-red-600 text-white" aria-label="{{ 'event.remove_favorite'|trans }}">{{ include('components/_icon.html.twig', {name: 'bookmark', class: 'size-4'}) }}</button>
                                    </form>
                                </div>
                                <div class="mt-4 grid grid-cols-[1fr_1.5fr_auto] gap-3">
                                    <form method="post" action="{{ path('app_event_favorite_reminder', {id: favorite.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('favorite_reminder_' ~ favorite.id) }}">
                                        <button
                                            type="submit"
                                            class="h-10 w-full rounded-lg text-xs font-semibold {{ favorite.reminderActive ? 'bg-indigo-600 text-white' : 'bg-slate-200 text-slate-600' }}"
                                            aria-pressed="{{ favorite.reminderActive ? 'true' : 'false' }}"
                                        >
                                            <span class="inline-flex items-center justify-center gap-1">{{ include('components/_icon.html.twig', {name: 'bell', class: 'size-4'}) }} {{ favorite.reminderActive ? 'event.reminder_on'|trans : 'event.reminder_off'|trans }}</span>
                                        </button>
                                    </form>
                                    <a href="{{ path('app_event') }}#event-{{ event.id }}" class="flex h-10 items-center justify-center gap-1 rounded-lg bg-slate-950 text-xs font-medium text-white">{{ include('components/_icon.html.twig', {name: 'eye', class: 'size-4'}) }} {{ 'common.view_detail'|trans }}</a>
                                    <a href="mailto:?subject={{ event.title|url_encode }}&body={{ event.location|url_encode }}" class="flex size-10 items-center justify-center rounded-lg bg-slate-200" aria-label="{{ 'common.share_email'|trans }}">{{ include('components/_icon.html.twig', {name: 'share', class: 'size-4'}) }}</a>
                                </div>
                            </article>
                        {% else %}
                            <div class="rounded-xl bg-slate-50 px-5 py-10 text-center">
                                <p class="font-semibold">{{ 'event.none_saved'|trans }}</p>
                                <a href="{{ path('app_event') }}" class="mt-4 inline-flex rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white">{{ 'event.discover'|trans }}</a>
                            </div>
                        {% endfor %}
                    </div>
                </section>

                <a href="{{ path('app_event') }}" class="flex min-h-16 items-center justify-between rounded-2xl bg-red-600 px-5 text-white">
                    <span>
                        <strong class="block">{{ 'event.discover_more'|trans }}</strong>
                        <span class="text-[10px]">{{ 'event.near_you'|trans }}</span>
                    </span>
                    {{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-5'}) }}
                </a>
            </main>

            {{ include('components/_bottom_nav.html.twig', { active: 'home' }) }}
        </div>
    </div>
{% endblock %}
