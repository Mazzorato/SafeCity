{# Sélection d’actualités affichée dans l’espace citoyen. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'news.title'|trans }}{% endblock %}

{% block body %}
    {% set category_labels = {
        securite: 'news.category.security'|trans,
        sante: 'news.category.health'|trans,
        mobilite: 'news.category.mobility'|trans,
        travaux: 'news.category.works'|trans
    } %}
    {% set category_colors = {
        securite: 'bg-red-100 text-red-600',
        sante: 'bg-blue-100 text-blue-600',
        mobilite: 'bg-violet-100 text-violet-600',
        travaux: 'bg-orange-100 text-orange-500'
    } %}

    <div class="min-h-screen bg-stone-200 font-sans text-slate-950">
        <div class="relative mx-auto min-h-screen w-full max-w-md bg-white pb-28 shadow-xl lg:max-w-7xl lg:pb-12 lg:pt-20 lg:shadow-none">
            <header class="flex items-start justify-between px-5 pb-5 pt-8">
                <div class="flex items-start gap-3">
                    <a href="{{ path('app_home') }}" class="flex size-8 items-center justify-center" aria-label="{{ 'common.back_home'|trans }}">{{ include('components/_icon.html.twig', {name: 'back', class: 'size-6'}) }}</a>
                    <div>
                        <h1 class="text-3xl font-bold">{{ 'news.title'|trans }}</h1>
                        <p class="font-medium text-red-600">{{ city ? city.name : 'city.none'|trans }} <span aria-hidden="true">●</span> {{ 'news.live'|trans }}</p>
                    </div>
                </div>
                <a href="{{ path('app_notifications') }}" class="relative mt-2 flex size-9 items-center justify-center" aria-label="{{ 'notification.title'|trans }}">
                    {{ include('components/_icon.html.twig', {name: 'bell', class: 'size-6'}) }}
                    {% if unreadCount > 0 %}
                        {# Ce témoin disparaît dès que toutes les notifications sont lues. #}
                        <span class="absolute right-0 top-0 size-2 rounded-full bg-red-600" data-notification-unread-indicator></span>
                    {% endif %}
                </a>
            </header>

            <main class="space-y-10 px-5 lg:grid lg:grid-cols-12 lg:gap-8 lg:space-y-0 lg:px-8 lg:py-8">
                <nav class="flex gap-3 overflow-x-auto pb-2 lg:col-span-12" aria-label="{{ 'news.filter'|trans }}">
                    {% set filters = {
                        all: 'common.all'|trans,
                        securite: 'news.category.security'|trans,
                        sante: 'news.category.health'|trans,
                        mobilite: 'news.category.mobility'|trans,
                        travaux: 'news.category.works'|trans
                    } %}
                    {% for value, label in filters %}
                        <a href="{{ path('app_news', {category: value}) }}" class="flex h-12 shrink-0 items-center rounded-xl px-5 text-sm {{ category == value ? 'bg-slate-950 font-semibold text-white' : 'bg-stone-200 text-slate-950' }}">
                            {{ label }}
                        </a>
                    {% endfor %}
                </nav>

                {% if featured %}
                    <article class="lg:col-span-7">
                        <div class="relative flex h-44 items-end overflow-hidden rounded-2xl bg-gradient-to-br from-red-500 to-red-800 p-5 text-white shadow-lg">
                            {% if featured.imageUrl %}
                                <img src="{{ featured.imageUrl }}" alt="" class="absolute inset-0 size-full object-cover opacity-40">
                            {% else %}
                                {{ include('components/_icon.html.twig', {name: 'news', class: 'absolute left-1/2 top-1/2 size-8 -translate-x-1/2 -translate-y-1/2 text-red-100'}) }}
                            {% endif %}
                            <span class="relative rounded-full bg-red-500 px-5 py-2 text-xs font-semibold">{{ category_labels[featured.category.value] }}</span>
                        </div>
                        <p class="mt-5 font-semibold text-red-600">{{ 'news.featured_now'|trans }} <span aria-hidden="true">●</span></p>
                        <h2 class="mt-3 text-2xl font-bold leading-tight">{{ featured.title }}</h2>
                        <div class="mt-5 flex items-center gap-8 text-sm font-semibold">
                            <span class="flex items-center gap-2">{{ include('components/_icon.html.twig', {name: 'clock', class: 'size-4'}) }} {{ featured.publishedAt|date('d/m à H:i') }}</span>
                            <span class="flex items-center gap-2">{{ include('components/_icon.html.twig', {name: 'news', class: 'size-4'}) }} {{ 'news.reading_time'|trans({'%minutes%': max(1, (featured.content|length / 900)|round(0, 'ceil'))}) }}</span>
                        </div>
                    </article>
                {% endif %}

                <section class="{{ featured ? 'lg:col-span-5' : 'lg:col-span-12' }}" aria-labelledby="latest-news-title">
                    <div class="mb-5 flex items-center justify-between">
                        <h2 id="latest-news-title" class="text-2xl font-bold">{{ 'news.latest'|trans }}</h2>
                        <a href="{{ path('app_news_all', {category: category}) }}" class="font-semibold text-red-600 underline">{{ 'common.view_all'|trans }}</a>
                    </div>
                    <div class="space-y-3">
                        {% for item in news|filter(item => not featured or item.id != featured.id)|slice(0, 3) %}
                            <article class="flex min-h-32 items-center gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                                <span class="flex size-24 shrink-0 items-center justify-center overflow-hidden bg-gradient-to-br from-orange-300 to-orange-600 text-white">
                                    {% if item.imageUrl %}
                                        <img src="{{ item.imageUrl }}" alt="" class="size-full object-cover">
                                    {% else %}
                                        {{ include('components/_icon.html.twig', {name: 'news', class: 'size-6'}) }}
                                    {% endif %}
                                </span>
                                <div class="min-w-0 flex-1">
                                    <span class="rounded-full px-3 py-1 text-[10px] font-semibold {{ category_colors[item.category.value] }}">{{ category_labels[item.category.value] }}</span>
                                    <h3 class="mt-2 line-clamp-2 font-bold leading-tight">{{ item.title }}</h3>
                                    <p class="mt-3 text-xs text-stone-500">{{ item.publishedAt|date('d/m/Y H:i') }} · {{ max(1, (item.content|length / 900)|round(0, 'ceil')) }} min</p>
                                </div>
                            </article>
                        {% else %}
                            <p class="rounded-xl bg-slate-50 px-5 py-8 text-center text-sm text-stone-500">{{ 'news.none_city'|trans }}</p>
                        {% endfor %}
                    </div>
                </section>
            </main>

            {{ include('components/_bottom_nav.html.twig', { active: 'news' }) }}
        </div>
    </div>
{% endblock %}
