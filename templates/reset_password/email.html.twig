{# Courriel contenant le lien de réinitialisation. #}
<h1>{{ 'email.greeting'|trans }}</h1>

<p>{{ 'email.reset.instructions'|trans }}</p>

<a href="{{ url('app_reset_password', {token: resetToken.token}) }}">{{ url('app_reset_password', {token: resetToken.token}) }}</a>

<p>{{ 'email.reset.expiry'|trans({
    '%expiration%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')
}) }}</p>

<p>{{ 'email.signature'|trans }}</p>
