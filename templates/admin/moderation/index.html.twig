{# File de traitement des dossiers de modération. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'moderation.title'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-slate-50 pb-28 text-slate-950 lg:max-w-5xl lg:pb-12 lg:pt-20">
    <header class="flex items-center border-b border-slate-100 bg-white px-5 py-5">
        <a href="{{ path('app_admin') }}" class="flex size-10 items-center justify-center rounded-full bg-slate-100 text-xl" aria-label="{{ 'common.back'|trans }}">‹</a>
        <div class="flex-1 text-center">
            <h1 class="text-xl font-bold">{{ 'moderation.queue'|trans }}</h1>
            <p class="text-xs text-slate-500">{{ 'moderation.pending_count'|trans({'%count%': pendingCount}) }}</p>
        </div>
        <span class="size-10"></span>
    </header>

    <div class="space-y-4 px-5 py-6 lg:px-8">
        {% for message in app.flashes('success') %}
            <div class="rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">{{ message }}</div>
        {% endfor %}

        {% if not schemaReady %}
            <div class="rounded-2xl border border-orange-200 bg-orange-50 p-4 text-sm leading-6 text-orange-900">
                {{ 'moderation.schema_pending'|trans }}
            </div>
        {% endif %}

        {% for item in items %}
            {% set moderation = item.case %}
            {# Les anciens dossiers français et les nouveaux codes stables
               convergent vers la même clé traduisible. #}
            {% set legacyReasons = {
                'Spam ou contenu répétitif': 'spam',
                'Données personnelles exposées': 'personal_data',
                'Contenu dangereux ou trompeur': 'dangerous',
                'Contenu inapproprié': 'inappropriate'
            } %}
            {% set reasonCode = legacyReasons[moderation.reason]|default(moderation.reason) %}
            <article class="rounded-2xl border border-slate-200 bg-white p-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-red-600">{{ moderation.targetType.value == 'comment' ? 'moderation.comment'|trans : 'moderation.photo'|trans }}</p>
                        <h2 class="mt-1 font-bold">{{ ('moderation.reason.' ~ reasonCode)|trans }}</h2>
                        <p class="mt-1 text-xs text-slate-500">{{ 'moderation.reported_on'|trans({'%date%': moderation.reportedAt|date('d/m/Y H:i')}) }}</p>
                    </div>
                    <span class="rounded-full px-2.5 py-1 text-xs font-semibold {{ moderation.status.value == 'flagged' ? 'bg-orange-100 text-orange-700' : moderation.status.value == 'hidden' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-500' }}">
                        {{ moderation.status.value == 'flagged' ? 'moderation.status.flagged'|trans : moderation.status.value == 'hidden' ? 'moderation.status.hidden'|trans : 'moderation.status.dismissed'|trans }}
                    </span>
                </div>

                <div class="mt-4 rounded-xl bg-slate-50 p-3">
                    {% if item.target is null %}
                        <p class="text-sm text-slate-500">{{ 'moderation.source_missing'|trans }}</p>
                    {% elseif moderation.targetType.value == 'comment' %}
                        <p class="whitespace-pre-line text-sm leading-6">{{ item.target.content }}</p>
                    {% else %}
                        <img src="{{ asset(item.target.url) }}" alt="{{ 'moderation.photo_to_review'|trans }}" class="max-h-56 w-full rounded-xl object-cover">
                    {% endif %}
                </div>

                <p class="mt-3 text-xs text-slate-500">{{ 'moderation.author'|trans }} : {{ moderation.author ? moderation.author.firstName ~ ' ' ~ moderation.author.lastName : 'moderation.account_unavailable'|trans }}</p>

                {% if moderation.status.value == 'flagged' %}
                    <div class="mt-4 grid grid-cols-2 gap-2">
                        {% for decision, labelKey in {hide: 'moderation.hide', dismiss: 'moderation.dismiss'} %}
                            <form method="post" action="{{ path('app_admin_moderation_decide', {id: moderation.id, decision: decision}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('moderation_' ~ moderation.id ~ '_' ~ decision) }}">
                                <button type="submit" class="h-11 w-full rounded-xl {{ decision == 'hide' ? 'bg-red-600 text-white' : 'bg-slate-100 text-slate-700' }} text-xs font-bold">{{ labelKey|trans }}</button>
                            </form>
                        {% endfor %}
                    </div>
                {% else %}
                    <form method="post" action="{{ path('app_admin_moderation_decide', {id: moderation.id, decision: 'reopen'}) }}" class="mt-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('moderation_' ~ moderation.id ~ '_reopen') }}">
                        <button type="submit" class="h-11 w-full rounded-xl bg-orange-50 text-sm font-bold text-orange-700">{{ 'moderation.reopen'|trans }}</button>
                    </form>
                {% endif %}
            </article>
        {% else %}
            {% if schemaReady %}
                <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">{{ 'moderation.none'|trans }}</p>
            {% endif %}
        {% endfor %}
    </div>
</main>

{% include 'components/_admin_nav.html.twig' with {active: 'moderation'} %}
{% endblock %}