{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.space'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-[#f8f8ff] pb-28 text-slate-950 shadow-xl lg:max-w-7xl lg:pb-12 lg:pt-20 lg:shadow-none">
    <header class="bg-white px-4 pb-5 pt-7">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-lg font-bold text-red-600">{{ 'admin.space'|trans }}</p>
                <h1 class="mt-1 text-xl font-bold">{{ 'admin.dashboard'|trans }}</h1>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('app_notifications') }}" class="relative flex size-9 items-center justify-center" aria-label="{{ 'notification.unread_count'|trans({'%count%': unreadNotifications}) }}">
                    {{ include('components/_icon.html.twig', {name: 'bell', class: 'size-5'}) }}
                    {% if unreadNotifications > 0 %}<span class="absolute right-0 top-0 flex size-5 items-center justify-center rounded-full bg-red-600 text-[10px] font-bold text-white">{{ unreadNotifications > 9 ? '9+' : unreadNotifications }}</span>{% endif %}
                </a>
                <a href="{{ path('app_profile') }}" class="flex size-9 items-center justify-center" aria-label="{{ 'profile.open'|trans }}">{{ include('components/_icon.html.twig', {name: 'user', class: 'size-5'}) }}</a>
            </div>
        </div>
        <a href="{{ path('app_home') }}" class="mt-4 flex h-10 items-center justify-between border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700">
            <span>{{ 'admin.citizen_space'|trans }}</span>
            {{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-4'}) }}
        </a>
    </header>

    <div class="space-y-6 px-3 pt-5 lg:px-8">
        {% for message in app.flashes('success') %}
            <div class="rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">{{ message }}</div>
        {% endfor %}

        <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="{{ 'admin.statistics'|trans }}">
            <article class="border border-slate-200 bg-white p-4">
                <div class="flex justify-between text-red-600"><span class="flex size-9 items-center justify-center rounded-lg bg-red-100">{{ include('components/_icon.html.twig', {name: 'alert', class: 'size-4'}) }}</span><small>+{{ stats.reported }}</small></div>
                <strong class="mt-3 block text-2xl">{{ stats.total }}</strong>
                <span class="text-sm text-red-950">{{ 'report.title'|trans }}</span>
            </article>
            <article class="border border-slate-200 bg-white p-4">
                <div class="flex justify-between text-orange-600"><span class="flex size-9 items-center justify-center rounded-lg bg-orange-100">{{ include('components/_icon.html.twig', {name: 'clock', class: 'size-4'}) }}</span><small>+{{ stats.reported }}</small></div>
                <strong class="mt-3 block text-2xl">{{ stats.reported }}</strong>
                <span class="text-sm text-red-950">{{ 'admin.pending'|trans }}</span>
            </article>
            <article class="border border-slate-200 bg-white p-4">
                <div class="flex justify-between text-blue-600"><span class="flex size-9 items-center justify-center rounded-lg bg-blue-100">{{ include('components/_icon.html.twig', {name: 'refresh', class: 'size-4'}) }}</span><small>+{{ stats.inProgress }}</small></div>
                <strong class="mt-3 block text-2xl">{{ stats.inProgress }}</strong>
                <span class="text-sm text-red-950">{{ 'report.status.in_progress'|trans }}</span>
            </article>
            <article class="border border-slate-200 bg-white p-4">
                <div class="flex justify-between text-emerald-600"><span class="flex size-9 items-center justify-center rounded-lg bg-emerald-100">{{ include('components/_icon.html.twig', {name: 'check', class: 'size-4'}) }}</span><small>+{{ stats.resolved }}</small></div>
                <strong class="mt-3 block text-2xl">{{ stats.resolved }}</strong>
                <span class="text-sm text-red-950">{{ 'report.status.resolved_plural'|trans }}</span>
            </article>
        </section>

        <section aria-labelledby="routing-rules">
            <div class="mb-3 flex items-center justify-between">
                <h2 id="routing-rules" class="text-xl font-bold">{{ 'admin.report_routing'|trans }}</h2>
                <span class="text-xs font-semibold text-red-600">{{ 'admin.configurable'|trans }}</span>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4">
                <div class="flex items-start gap-3">
                    <span class="flex size-9 shrink-0 items-center justify-center bg-orange-100 text-orange-700" aria-hidden="true">{{ include('components/_icon.html.twig', {name: 'send', class: 'size-4'}) }}</span>
                    <div>
                        <h3 class="font-bold">{{ 'admin.automatic_rules'|trans }}</h3>
                        <p class="mt-1 text-sm leading-5 text-slate-500">{{ 'admin.automatic_rules_help'|trans }}</p>
                    </div>
                </div>
                <a href="{{ path('app_admin_routing') }}" class="mt-4 flex h-11 items-center justify-center rounded-xl bg-slate-950 text-sm font-bold text-white">{{ 'admin.configure_routing'|trans }}</a>
            </div>
        </section>

        <section aria-labelledby="moderation-queue">
            <div class="mb-3 flex items-center justify-between">
                <h2 id="moderation-queue" class="font-bold">{{ 'moderation.queue'|trans }}</h2>
                <span class="text-xs font-semibold {{ moderationPending > 0 ? 'text-red-600' : 'text-slate-400' }}">{{ 'moderation.item_count'|trans({'%count%': moderationPending}) }}</span>
            </div>
            <a href="{{ path('app_admin_moderation') }}" class="flex items-center gap-3 border border-slate-200 bg-white px-4 py-4">
                <span class="flex size-9 items-center justify-center {{ moderationPending > 0 ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-500' }}" aria-hidden="true">{{ include('components/_icon.html.twig', {name: 'alert', class: 'size-4'}) }}</span>
                <span class="flex-1">
                    <strong class="block">{{ moderationReady ? (moderationPending > 0 ? 'moderation.awaiting_decision'|trans : 'moderation.nothing_to_review'|trans) : 'moderation.migration_pending'|trans }}</strong>
                    <small class="mt-1 block text-slate-500">{{ 'moderation.actions_help'|trans }}</small>
                </span>
                {{ include('components/_icon.html.twig', {name: 'chevron-right', class: 'size-4'}) }}
            </a>
        </section>

        <section aria-labelledby="reports-to-process">
            <div class="mb-3 flex items-center justify-between">
                <h2 id="reports-to-process" class="text-xl font-bold">{{ 'admin.reports_to_process'|trans }}</h2>
                <a href="{{ path('app_report_index') }}" class="text-xs font-semibold text-red-600">{{ 'common.view_all'|trans }}</a>
            </div>
            <div class="space-y-3">
                {% for report in reports %}
                    <article class="overflow-hidden border border-slate-200 bg-white">
                        <div class="flex items-start gap-3 p-4">
                            <span class="flex size-10 shrink-0 items-center justify-center bg-red-50 text-red-600">{{ include('components/_icon.html.twig', {name: 'car', class: 'size-5'}) }}</span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-2">
                                    <h3 class="truncate font-bold">{{ report.category.name }}</h3>
                                    <span class="rounded bg-red-50 px-2 py-1 text-[10px] text-red-600">{{ ('report.status.' ~ report.status.value)|trans }}</span>
                                </div>
                                <p class="mt-1 truncate text-xs">{{ report.address ?: report.city.name }} · {{ report.createdAt|date('d/m H:i') }}</p>
                                <p class="mt-2 flex items-center gap-1 text-xs text-slate-400">{{ include('components/_icon.html.twig', {name: 'comment', class: 'size-4'}) }} {{ report.comments|length }}</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 border-t border-slate-200 text-xs font-semibold">
                            {% set actions = {reported: 'admin.pending', in_progress: 'report.status.in_progress', resolved: 'report.status.resolved'} %}
                            {% for value, labelKey in actions %}
                                <form method="post" action="{{ path('app_admin_report_status', {id: report.id, status: value}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('report_status_' ~ report.id ~ '_' ~ value) }}">
                                    <button type="submit" class="h-11 w-full {{ report.status.value == value ? (value == 'resolved' ? 'bg-emerald-100 text-emerald-700' : value == 'in_progress' ? 'bg-red-100 text-red-600' : 'bg-orange-100 text-orange-700') : 'bg-white text-slate-400' }}">{{ labelKey|trans }}</button>
                                </form>
                            {% endfor %}
                        </div>
                    </article>
                {% else %}
                    <p class="rounded-xl bg-white p-6 text-center text-sm text-slate-500">{{ 'admin.no_report_to_process'|trans }}</p>
                {% endfor %}
            </div>
        </section>
    </div>
</main>

{% include 'components/_admin_nav.html.twig' with {active: 'home'} %}
{% endblock %}