{# Liste et gestion des règles d’orientation. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.routing_automatic'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-slate-50 pb-28 text-slate-950 lg:max-w-7xl lg:pb-12 lg:pt-20">
    <header class="flex items-center border-b border-slate-100 bg-white px-5 py-5">
        <a href="{{ path('app_admin') }}" class="flex size-10 items-center justify-center rounded-full bg-slate-100 text-xl" aria-label="{{ 'common.back'|trans }}">‹</a>
        <div class="flex-1 text-center">
            <h1 class="text-xl font-bold">{{ 'admin.routing_automatic'|trans }}</h1>
            <p class="text-xs text-slate-500">{{ 'admin.routing_subtitle'|trans }}</p>
        </div>
        <span class="size-10"></span>
    </header>

    <div class="space-y-6 px-5 py-6 lg:grid lg:grid-cols-2 lg:items-start lg:gap-8 lg:space-y-0 lg:px-8">
        {% for message in app.flashes('success') %}
            <div class="rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">{{ message }}</div>
        {% endfor %}

        {% if not schemaReady %}
            <div class="rounded-2xl border border-orange-200 bg-orange-50 p-4 text-sm leading-6 text-orange-900">
                {{ 'admin.routing_schema_pending'|trans }}
            </div>
        {% else %}
            <section aria-labelledby="new-routing-rule">
                <h2 id="new-routing-rule" class="mb-3 text-lg font-bold">{{ 'admin.new_rule'|trans }}</h2>
                <div class="rounded-3xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
                    {% include 'admin/routing/_form.html.twig' with {form: form} %}
                </div>
            </section>
        {% endif %}

        <section aria-labelledby="routing-rule-list">
            <div class="mb-3 flex items-center justify-between">
                <h2 id="routing-rule-list" class="text-lg font-bold">{{ 'admin.configured_rules'|trans }}</h2>
                <span class="text-sm text-slate-500">{{ rules|length }}</span>
            </div>
            <div class="space-y-3">
                {% for rule in rules %}
                    <article class="rounded-2xl border border-slate-200 bg-white p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <h3 class="font-bold">{{ rule.category ? rule.category.name : 'admin.all_categories'|trans }}</h3>
                                <p class="mt-1 text-sm text-slate-500">
                                    {{ ('gravity.' ~ rule.gravityLevel.value)|trans }}
                                    · {{ 'admin.priority_value'|trans({'%priority%': rule.priority}) }}
                                </p>
                                <p class="mt-2 text-sm font-semibold text-red-700">→ {{ rule.emergencyService.name }}</p>
                            </div>
                            <span class="rounded-full px-2.5 py-1 text-xs font-semibold {{ rule.enabled ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' }}">{{ rule.enabled ? 'admin.active_feminine'|trans : 'admin.inactive_feminine'|trans }}</span>
                        </div>
                        <div class="mt-4 grid grid-cols-2 gap-2">
                            <a href="{{ path('app_admin_routing_edit', {id: rule.id}) }}" class="flex h-10 items-center justify-center rounded-xl bg-slate-100 text-sm font-semibold">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('app_admin_routing_toggle', {id: rule.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('routing_rule_toggle_' ~ rule.id) }}">
                                <button type="submit" class="h-10 w-full rounded-xl {{ rule.enabled ? 'bg-orange-50 text-orange-700' : 'bg-emerald-50 text-emerald-700' }} text-sm font-semibold">{{ rule.enabled ? 'admin.disable'|trans : 'admin.enable'|trans }}</button>
                            </form>
                        </div>
                    </article>
                {% else %}
                    <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">{{ 'admin.no_rule'|trans }}</p>
                {% endfor %}
            </div>
        </section>
    </div>
</main>

{% include 'components/_admin_nav.html.twig' with {active: 'routing'} %}
{% endblock %}