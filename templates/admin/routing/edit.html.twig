{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.edit_routing_rule'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-slate-50 text-slate-950 lg:my-10 lg:min-h-0 lg:max-w-3xl lg:rounded-3xl lg:shadow-xl">
    <header class="flex items-center border-b border-slate-100 bg-white px-5 py-5">
        <a href="{{ path('app_admin_routing') }}" class="flex size-10 items-center justify-center rounded-full bg-slate-100 text-xl" aria-label="{{ 'common.back'|trans }}">‹</a>
        <h1 class="flex-1 text-center text-xl font-bold">{{ 'admin.edit_rule'|trans }}</h1>
        <span class="size-10"></span>
    </header>

    <div class="px-5 py-6 lg:px-8 lg:py-8">
        <div class="rounded-3xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
            {% include 'admin/routing/_form.html.twig' with {form: form, button_label: 'common.save_changes'|trans} %}
        </div>
    </div>
</main>
{% endblock %}