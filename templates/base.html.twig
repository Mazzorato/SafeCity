<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}SafeCity{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {% set notificationsEnabled = app.user and app.user.profile and (
        app.user.profile.emergencyNotifications
        or app.user.profile.transportNotifications
        or app.user.profile.eventNotifications
    ) %}
    <body
        {% if app.user %}
            data-controller="notifications"
            data-notifications-enabled-value="{{ notificationsEnabled ? 'true' : 'false' }}"
            data-notifications-url-value="{{ mercure(notification_topic(app.user)) }}"
        {% endif %}
    >
        {% block body %}{% endblock %}
        {% if app.user %}
            {% set currentRoute = app.request.attributes.get('_route')|default('') %}
            {% if not (currentRoute starts with 'app_admin') %}
            <a
                href="{{ path('app_profile') }}"
                class="fixed right-4 top-4 z-50 flex size-11 items-center justify-center rounded-full bg-slate-950 text-white shadow-lg transition hover:bg-red-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
                aria-label="{{ 'profile.open'|trans }}"
                title="{{ 'profile.open'|trans }}"
            >
                {# Raccourci de profil commun aux écrans citoyens. #}
                {{ include('components/_icon.html.twig', {name: 'user', class: 'size-5'}) }}
            </a>
            {% endif %}
            <aside class="fixed inset-x-4 top-4 z-50 mx-auto hidden max-w-sm rounded-2xl bg-slate-950 p-4 text-white shadow-2xl" data-notifications-target="toast" role="status">
                <div class="flex items-start gap-3">
                    <a href="{{ path('app_notifications') }}" class="min-w-0 flex-1">
                        <strong class="block" data-notifications-target="title">SafeCity</strong>
                        <span class="mt-1 block text-sm leading-5 text-slate-300" data-notifications-target="message"></span>
                    </a>
                    <button type="button" class="text-xl text-slate-400" data-action="notifications#close" aria-label="{{ 'common.close'|trans }}">×</button>
                </div>
            </aside>
        {% endif %}
    </body>
</html>