{# Frise réutilisable de progression d’un signalement. #}
{% set currentStep = report.status.value == 'resolved' ? 3 : (report.status.value == 'in_progress' ? 2 : 1) %}
{% set completedColor = report.status.value == 'resolved' ? 'bg-emerald-600' : 'bg-slate-950' %}
{% set darkMode = dark|default(false) %}

<div class="relative grid grid-cols-3 text-center">
    <div class="absolute left-[16.66%] right-[16.66%] top-3 h-0.5 {{ darkMode ? 'bg-slate-600' : 'bg-slate-200' }}"></div>
    <div class="absolute left-[16.66%] top-3 h-0.5 {{ darkMode ? 'bg-white' : completedColor }} {{ currentStep == 1 ? 'w-0' : currentStep == 2 ? 'w-1/3' : 'right-[16.66%]' }}"></div>
    {% for label in ['report.status.sent'|trans, 'report.status.in_progress'|trans, 'report.status.resolved'|trans] %}
        {% set step = loop.index %}
        <div class="relative">
            <span class="mx-auto flex size-6 items-center justify-center rounded-full border-2 {{ currentStep >= step ? (darkMode ? 'border-white bg-white text-slate-950' : completedColor ~ ' border-transparent text-white') : (darkMode ? 'border-slate-400 bg-slate-950 text-transparent' : 'border-slate-300 bg-white text-transparent') }}">{{ include('components/_icon.html.twig', {name: 'check', class: 'size-3.5'}) }}</span>
            <span class="mt-2 block text-[10px] font-medium {{ darkMode ? (currentStep >= step ? 'text-white' : 'text-slate-400') : (currentStep >= step ? (report.status.value == 'resolved' ? 'text-emerald-700' : 'text-slate-700') : 'text-slate-400') }}">{{ label }}</span>
        </div>
    {% endfor %}
</div>


