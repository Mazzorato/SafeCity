{# Carte réutilisable présentant un signalement. #}
{% set statusMeta = {
    reported: {label: 'report.status.reported'|trans, badge: 'bg-orange-100 text-orange-700', accent: 'border-orange-500'},
    in_progress: {label: 'report.status.in_progress'|trans, badge: 'bg-blue-100 text-blue-700', accent: 'border-blue-600'},
    resolved: {label: 'report.status.resolved'|trans, badge: 'bg-emerald-100 text-emerald-700', accent: 'border-emerald-600'}
} %}
{% set meta = statusMeta[report.status.value] %}
{% set categoryIcon = report.category.icon|lower %}
{% set symbol = categoryIcon in ['accident', 'route', 'voiture'] ? 'car' : (categoryIcon in ['travaux', 'chantier'] ? 'construction' : (categoryIcon in ['incendie'] ? 'fire' : (categoryIcon in ['urgence', 'sante'] ? 'health' : 'alert'))) %}

<article class="{{ showProgress|default(false) ? 'border border-slate-200' : 'border-l-4' }} {{ meta.accent }} bg-white p-4">
    <div class="flex items-start gap-3">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-950" aria-hidden="true">{{ include('components/_icon.html.twig', {name: symbol, class: 'size-6'}) }}</span>
        <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                    <h3 class="truncate font-bold">{{ report.category.name }}</h3>
                    <p class="mt-1 truncate text-xs text-slate-500">{{ report.address ?: 'report.address_missing'|trans }}</p>
                </div>
                <span class="shrink-0 rounded-full px-3 py-1 text-xs font-semibold {{ meta.badge }}">{{ meta.label }}</span>
            </div>
            <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
                <span>{{ report.createdAt|date('d/m/Y · H:i') }}</span>
                <span class="flex items-center gap-1">{{ include('components/_icon.html.twig', {name: 'comment', class: 'size-4'}) }} {{ report.comments|length }}</span>
            </div>
        </div>
    </div>

    {% if showProgress|default(false) %}
        <div class="mt-4 border-t border-slate-100 pt-4">
            {% include 'report/_status_steps.html.twig' with {report: report} %}
        </div>
    {% endif %}

    {% if not compact|default(false) %}
        <div class="mt-4 flex border-t border-slate-100 pt-3 text-sm font-semibold">
            <a href="{{ path('app_report_show', {id: report.id}) }}" class="flex-1 text-center underline decoration-slate-300 underline-offset-4">{{ 'common.view_detail'|trans }}</a>
            {% if report.reporter and app.user and report.reporter.id == app.user.id %}
                <a href="{{ path('app_report_follow_up', {id: report.id}) }}" class="flex-1 text-center text-red-600">{{ 'report.follow'|trans }}</a>
            {% endif %}
        </div>
    {% endif %}
</article>


