{# Édition administrative d’un signalement. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'report.edit_title'|trans({'%id%': report.id}) }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-[#f8f8ff] pb-10 text-slate-950 shadow-xl lg:my-10 lg:min-h-0 lg:max-w-4xl lg:rounded-3xl">
    <header class="flex items-center border-b border-slate-100 bg-white px-5 py-5">
        <a href="{{ path('app_report_index') }}" class="flex size-10 items-center justify-center" aria-label="{{ 'common.back_list'|trans }}">{{ include('components/_icon.html.twig', {name: 'back', class: 'size-7'}) }}</a>
        <h1 class="flex-1 text-center text-xl font-bold">{{ 'report.edit_short'|trans({'%id%': report.id}) }}</h1>
        <span class="size-10"></span>
    </header>

    {{ form_start(form, {attr: {class: 'space-y-6 px-5 py-6 lg:px-8 lg:py-8'}}) }}
        <section>
            {{ form_label(form.category, null, {label_attr: {class: 'mb-3 block font-bold'}}) }}
            <div class="grid grid-cols-2 gap-2">
                {% for choice in form.category %}
                    <div>
                        {{ form_widget(choice, {attr: {class: 'peer sr-only'}}) }}
                        <label for="{{ choice.vars.id }}" class="flex min-h-12 cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white px-3 text-center text-sm font-semibold peer-checked:border-red-600 peer-checked:bg-red-600 peer-checked:text-white">{{ choice.vars.label }}</label>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-1 text-xs text-red-600">{{ form_errors(form.category) }}</div>
        </section>

        <section>
            {{ form_label(form.gravityLevel, null, {label_attr: {class: 'mb-3 block font-bold'}}) }}
            <div class="grid grid-cols-3 gap-2">
                {% for choice in form.gravityLevel %}
                    <div>
                        {{ form_widget(choice, {attr: {class: 'peer sr-only'}}) }}
                        <label for="{{ choice.vars.id }}" class="flex h-12 cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white text-sm font-semibold peer-checked:border-slate-950 peer-checked:bg-slate-950 peer-checked:text-white">{{ choice.vars.label }}</label>
                    </div>
                {% endfor %}
            </div>
        </section>

        <section>
            {{ form_label(form.description, null, {label_attr: {class: 'mb-2 block font-bold'}}) }}
            {{ form_widget(form.description, {attr: {class: 'min-h-36 w-full resize-none rounded-2xl border border-slate-200 bg-white p-4 text-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100'}}) }}
            <div class="mt-1 text-xs text-red-600">{{ form_errors(form.description) }}</div>
        </section>

        <section>
            {{ form_label(form.emergencyService, null, {label_attr: {class: 'mb-2 block font-bold'}}) }}
            {{ form_widget(form.emergencyService, {attr: {class: 'h-12 w-full rounded-2xl border border-slate-200 bg-white px-4 text-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100'}}) }}
            <p class="mt-2 text-xs text-slate-500">{{ 'report.active_services_only'|trans }}</p>
            <div class="mt-1 text-xs text-red-600">{{ form_errors(form.emergencyService) }}</div>
        </section>

        <div class="rounded-2xl bg-white p-4 ring-1 ring-slate-100">
            <p class="text-sm font-semibold">{{ 'report.saved_location'|trans }}</p>
            <p class="mt-1 text-sm text-slate-500">{{ report.address ?: report.city.name }}</p>
        </div>

        {{ form_widget(form.address) }}
        {{ form_widget(form.latitude) }}
        {{ form_widget(form.longitude) }}
        {% if form._token is defined %}{{ form_widget(form._token) }}{% endif %}

        <button type="submit" class="h-14 w-full rounded-xl bg-red-600 font-bold text-white shadow-sm transition hover:bg-red-700">{{ 'common.save_changes'|trans }}</button>
    {{ form_end(form, {render_rest: false}) }}

    {# La suppression reste séparée de l’édition et protégée par une confirmation Stimulus. #}
    <div class="px-5 pb-6">
        {{ include('report/_delete_form.html.twig') }}
    </div>
</main>
{% endblock %}


