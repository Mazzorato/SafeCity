{% extends 'base.html.twig' %}

{% block title %}Détail du signalement{% endblock %}

{% block body %}
<main>
    <h1>Détail du signalement</h1>
    <p>{{ report.category ? report.category.name : 'Autre' }}</p>
    <p>{{ report.address ?: 'Adresse non renseignée' }}</p>
    <p>{{ report.description }}</p>
    <p>Créé le {{ report.createdAt|date('d/m/Y H:i') }}</p>

    {% include 'report/_status_steps.html.twig' with {report: report} %}

    {% if report.photos is not empty %}
        <section>
            <h2>Photos</h2>
            {% for photo in report.photos %}
                <img src="{{ asset(photo.url) }}" alt="Photo du signalement">
            {% endfor %}
        </section>
    {% endif %}
</main>

<section id="comments">
    <h2>Commentaires : {{ comments|length }}</h2>

    {% for comment in comments %}
        <article>
            <strong>{{ comment.author ? comment.author.firstName : 'Utilisateur SafeCity' }}</strong>
            <p>{{ comment.content }}</p>
            {% if comment.photos is not empty %}
                <p>{{ comment.photos|length }} photo ajoutée</p>
                {% for photo in comment.photos %}
                    <img src="{{ asset(photo.url) }}" alt="Photo ajoutée au commentaire">
                {% endfor %}
            {% endif %}
        </article>
    {% else %}
        <p>Aucun commentaire pour le moment.</p>
    {% endfor %}

    {{ form_start(commentForm, {attr: {'data-controller': 'photo-preview'}}) }}
        {{ form_row(commentForm.content) }}
        <button type="submit">Envoyer</button>
    {{ form_end(commentForm) }}
</section>
{% endblock %}
