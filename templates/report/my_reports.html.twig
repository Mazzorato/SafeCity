{# Historique personnel des signalements créés. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'report.my_reports'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-white pb-28 text-slate-950 shadow-xl lg:max-w-7xl lg:pb-12 lg:pt-20 lg:shadow-none">
    <header class="bg-white px-5 pb-5 pt-6">
        <div class="flex items-center gap-4">
            <a href="{{ path('app_profile') }}" class="flex size-10 items-center justify-center" aria-label="{{ 'common.back'|trans }}">{{ include('components/_icon.html.twig', {name: 'back', class: 'size-7'}) }}</a>
            <h1 class="text-2xl font-bold">{{ 'report.my_reports'|trans }}</h1>
        </div>
    </header>

    <div class="space-y-6 px-5 pt-5 lg:px-8">
        {% for message in app.flashes('success') %}
            <div class="rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">{{ message }}</div>
        {% endfor %}

        <section class="grid grid-cols-3 rounded-2xl bg-slate-200/70 px-3 py-4 text-center" aria-label="{{ 'report.my_stats'|trans }}">
            <div>
                <strong class="block text-xl">{{ stats.total }}</strong>
                <span class="text-xs font-semibold">{{ 'common.total'|trans }}</span>
            </div>
            <div>
                <strong class="block text-xl text-red-600">{{ stats.reported + stats.inProgress }}</strong>
                <span class="text-xs font-semibold">{{ 'report.status.in_progress'|trans }}</span>
            </div>
            <div>
                <strong class="block text-xl text-emerald-600">{{ stats.resolved }}</strong>
                <span class="text-xs font-semibold">{{ 'report.status.resolved_plural'|trans }}</span>
            </div>
        </section>

        <nav class="flex gap-2 overflow-x-auto" aria-label="{{ 'report.filter_mine'|trans }}">
            {% set filters = {
                'all': 'common.all'|trans,
                'in_progress': 'report.status.in_progress'|trans,
                'resolved': 'report.status.resolved_plural'|trans,
                'reported': 'report.status.reported_plural'|trans
            } %}
            {% for value, label in filters %}
                <a href="{{ path('app_report_my_reports', {status: value, sort: sort}) }}" class="shrink-0 rounded-xl px-4 py-3 text-sm font-semibold {{ status == value ? 'bg-slate-950 text-white' : 'border border-slate-200 bg-white text-slate-500' }}" {% if status == value %}aria-current="page"{% endif %}>{{ label }}</a>
            {% endfor %}
        </nav>

        <section aria-labelledby="my-report-results">
            <div class="mb-3 flex items-center justify-between gap-3">
                <h2 id="my-report-results" class="font-bold">{{ 'report.count'|trans({'%count%': reports|length}) }}</h2>
                <a href="{{ path('app_report_my_reports', {status: status, sort: sort == 'recent' ? 'oldest' : 'recent'}) }}" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold">{{ sort == 'recent' ? 'common.recent'|trans : 'common.oldest'|trans }} ↕</a>
            </div>

            <div class="space-y-4 lg:grid lg:grid-cols-2 lg:gap-4 lg:space-y-0">
                {% for report in reports %}
                    {% include 'report/_card.html.twig' with {report: report, showProgress: true} %}
                {% else %}
                    <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
                        <span class="text-3xl text-slate-400" aria-hidden="true">!</span>
                        <p class="mt-3 font-semibold">{{ 'report.none'|trans }}</p>
                        <p class="mt-1 text-sm text-slate-500">{{ 'report.none_category'|trans }}</p>
                    </div>
                {% endfor %}
            </div>
        </section>

        <a href="{{ path('app_report_new') }}" class="flex h-14 items-center justify-center gap-2 rounded-xl bg-red-600 font-bold text-white">{{ include('components/_icon.html.twig', {name: 'plus', class: 'size-5'}) }} {{ 'report.new'|trans }}</a>
    </div>
</main>

{% include 'components/_bottom_nav.html.twig' with {active: ''} %}
{% endblock %}


