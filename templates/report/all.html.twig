{# Liste complète des signalements accessibles à l’utilisateur. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'report.all'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-white pb-28 text-slate-950 shadow-xl lg:max-w-7xl lg:pb-12 lg:pt-20 lg:shadow-none">
    <header class="bg-white px-5 pb-5 pt-6">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold">{{ 'report.all'|trans }}</h1>
                <p class="mt-1 flex items-center gap-1 text-sm text-slate-400">{{ include('components/_icon.html.twig', {name: 'pin', class: 'size-4 text-red-600'}) }} {{ city ? 'event.city_area'|trans({'%city%': city.name}) : 'city.none_selected'|trans }}</p>
            </div>
            <a href="{{ path('app_report_map') }}" class="flex size-11 items-center justify-center rounded-xl bg-slate-100" aria-label="{{ 'report.show_map'|trans }}">{{ include('components/_icon.html.twig', {name: 'map', class: 'size-6'}) }}</a>
        </div>

        <section class="mt-5 grid grid-cols-4 gap-2 text-center" aria-label="{{ 'report.stats'|trans }}">
            <div class="border border-slate-200 bg-white px-1 py-3">
                <strong class="block text-lg">{{ stats.total }}</strong>
                <span class="text-[10px]">{{ 'common.total'|trans }}</span>
            </div>
            <div class="border border-orange-200 bg-orange-50 px-1 py-3 text-orange-600">
                <strong class="block text-lg">{{ stats.reported }}</strong>
                <span class="text-[10px]">{{ 'report.status.reported_plural'|trans }}</span>
            </div>
            <div class="border border-blue-200 bg-blue-50 px-1 py-3 text-blue-600">
                <strong class="block text-lg">{{ stats.inProgress }}</strong>
                <span class="text-[10px]">{{ 'report.status.in_progress'|trans }}</span>
            </div>
            <div class="rounded-lg bg-emerald-600 px-1 py-3 text-white">
                <strong class="block text-lg">{{ stats.resolved }}</strong>
                <span class="text-[10px]">{{ 'report.status.resolved_plural'|trans }}</span>
            </div>
        </section>
    </header>

    <div class="space-y-5 px-5 pt-5 lg:px-8">
        <form method="get" action="{{ path('app_report_all') }}" class="flex gap-2">
            <label class="relative flex-1">
                <span class="sr-only">{{ 'report.search'|trans }}</span>
                <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-400" aria-hidden="true">{{ include('components/_icon.html.twig', {name: 'search', class: 'size-5'}) }}</span>
                <input type="search" name="query" value="{{ search }}" placeholder="{{ 'report.search_placeholder'|trans }}" class="h-12 w-full rounded-2xl border border-slate-200 bg-white pl-11 pr-4 text-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-100">
            </label>
            <input type="hidden" name="status" value="{{ status }}">
            <input type="hidden" name="sort" value="{{ sort }}">
            <button type="submit" class="flex size-12 items-center justify-center rounded-2xl bg-slate-950 text-white" aria-label="{{ 'common.start_search'|trans }}">{{ include('components/_icon.html.twig', {name: 'search', class: 'size-5'}) }}</button>
        </form>

        <nav class="flex gap-2 overflow-x-auto" aria-label="{{ 'report.filter'|trans }}">
            {% set filters = {
                'all': 'common.all'|trans,
                'in_progress': 'report.status.in_progress'|trans,
                'resolved': 'report.status.resolved_plural'|trans,
                'reported': 'report.status.reported_plural'|trans
            } %}
            {% for value, label in filters %}
                <a href="{{ path('app_report_all', {status: value, query: search, sort: sort}) }}" class="shrink-0 rounded-xl px-4 py-3 text-sm font-semibold {{ status == value ? 'bg-slate-950 text-white' : 'border border-slate-200 bg-white text-slate-500' }}" {% if status == value %}aria-current="page"{% endif %}>{{ label }}</a>
            {% endfor %}
        </nav>

        <section aria-labelledby="all-report-results">
            <div class="mb-3 flex items-center justify-between gap-3">
                <div>
                    <h2 id="all-report-results" class="font-bold">{{ 'report.count'|trans({'%count%': reports|length}) }}</h2>
                    <p class="mt-2 text-xs text-slate-400"><span class="mr-2 text-red-600">●</span>{{ 'report.data_updated'|trans }}</p>
                </div>
                <a href="{{ path('app_report_all', {status: status, query: search, sort: sort == 'recent' ? 'oldest' : 'recent'}) }}" class="shrink-0 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold">{{ sort == 'recent' ? 'common.recent'|trans : 'common.oldest'|trans }} ↕</a>
            </div>

            <div class="space-y-3 lg:grid lg:grid-cols-2 lg:gap-4 lg:space-y-0">
                {% for report in reports %}
                    <a href="{{ path('app_report_show', {id: report.id}) }}" class="block">
                        {% include 'report/_card.html.twig' with {report: report, compact: true} %}
                    </a>
                {% else %}
                    <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
                        {{ include('components/_icon.html.twig', {name: 'search', class: 'mx-auto size-8 text-slate-400'}) }}
                        <p class="mt-3 font-semibold">{{ 'report.none_found'|trans }}</p>
                        <p class="mt-1 text-sm text-slate-500">{{ 'common.change_search_filter'|trans }}</p>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>
</main>

{% include 'components/_bottom_nav.html.twig' with {active: ''} %}
{% endblock %}


