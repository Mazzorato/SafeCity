{# Liste administrative de tous les signalements. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'report.management'|trans }}{% endblock %}

{% block body %}
<main class="mx-auto min-h-screen max-w-md bg-slate-50 pb-28 text-slate-950 lg:max-w-7xl lg:pb-12 lg:pt-20">
    <header class="bg-white px-5 pb-5 pt-6">
        <div class="flex items-center gap-4">
            <a href="{{ path('app_report_index') }}" class="flex size-10 items-center justify-center rounded-full bg-slate-100 text-xl" aria-label="{{ 'admin.back_dashboard'|trans }}">‹</a>
            <div>
                <h1 class="text-2xl font-bold">{{ 'report.title'|trans }}</h1>
                <p class="text-sm text-slate-500">{{ 'report.file_count'|trans({'%count%': reports|length}) }}</p>
            </div>
        </div>
    </header>

    <section class="space-y-3 px-4 pt-5 lg:grid lg:grid-cols-2 lg:gap-4 lg:space-y-0 lg:px-8" aria-label="{{ 'report.list'|trans }}">
        {% for message in app.flashes('success') %}
            <div class="rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">{{ message }}</div>
        {% endfor %}

        {% for report in reports %}
            <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
                <div class="flex items-start gap-3 p-4">
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-red-50 font-bold text-red-600">!</span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <h2 class="font-bold">#{{ report.id }} · {{ report.category.name }}</h2>
                                <p class="mt-1 truncate text-xs text-slate-500">{{ report.address ?: report.city.name }}</p>
                            </div>
                            <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold {{ report.status.value == 'resolved' ? 'bg-emerald-100 text-emerald-700' : report.status.value == 'in_progress' ? 'bg-blue-100 text-blue-700' : 'bg-orange-100 text-orange-700' }}">{{ ('report.status.' ~ report.status.value)|trans }}</span>
                        </div>
                        <p class="mt-2 line-clamp-2 text-sm text-slate-700">{{ report.description }}</p>
                        <p class="mt-2 text-xs font-semibold {{ report.emergencyService ? 'text-emerald-700' : 'text-orange-700' }}">{{ report.emergencyService ? 'report.assigned_to'|trans({'%service%': report.emergencyService.name}) : 'report.awaiting_assignment'|trans }}</p>
                        <p class="mt-2 text-xs text-slate-400">{{ report.createdAt|date('d/m/Y H:i') }} · {{ 'report.comment_count'|trans({'%count%': report.comments|length}) }}</p>
                    </div>
                </div>
                <div class="grid grid-cols-3 border-t border-slate-200 text-xs font-semibold">
                    <a href="{{ path('app_report_show', {id: report.id}) }}" class="flex h-11 items-center justify-center bg-white">{{ 'common.detail'|trans }}</a>
                    <a href="{{ path('app_report_edit', {id: report.id}) }}" class="flex h-11 items-center justify-center border-x border-slate-200 bg-white">{{ 'common.edit'|trans }}</a>
                    <span class="flex h-11 items-center justify-center bg-slate-100 text-sm">{{ report.status.value }}</span>
                </div>
            </article>
        {% else %}
            <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">{{ 'report.none_recorded'|trans }}</p>
        {% endfor %}
    </section>
</main>

{% include 'components/_admin_nav.html.twig' with {active: 'reports'} %}
{% endblock %}


